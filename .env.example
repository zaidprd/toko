# Konfigurasi Domain Toko
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=toko.zaidly.com

# 1. Payment Gateway (Mayar.id)
# Dapatkan dari: Dashboard Mayar > Integration > API Keys
MAYAR_API_KEY=your_mayar_api_key_here
MAYAR_WEBHOOK_SECRET=your_mayar_webhook_token_here
MAYAR_API_URL=https://api.mayar.id/hl/v2

# 2. Logistik & Ekspedisi (KiriminAja)
# Dapatkan dari: Dashboard KiriminAja > Pengaturan > Open API
KIRIMINAJA_API_KEY=your_kiriminaja_api_key_here
KIRIMINAJA_BASE_URL=https://api.kiriminaja.com/v1
KIRIMINAJA_WEBHOOK_SECRET=your_kiriminaja_webhook_secret_here

# 3. Penyimpanan Ebook Digital (Cloudflare R2 - Opsional untuk file PDF aman)
# Dapatkan dari: Dashboard Cloudflare > R2 > Manage R2 API Tokens
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=zaidly-kids-ebooks

# Database persisten (service role hanya server-side; jangan gunakan prefix NEXT_PUBLIC_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 4. Alamat Gudang / Asal Pengiriman Toko (Origin KiriminAja)
STORE_ORIGIN_ADDRESS="Kebon Jeruk, Jakarta Barat"
STORE_ORIGIN_DISTRICT="Kebon Jeruk"
STORE_ORIGIN_CITY="Jakarta Barat"
STORE_ORIGIN_PROVINCE="DKI Jakarta"
STORE_ORIGIN_POSTAL_CODE="11550"

# 5. Keamanan Admin Toko (Server-Side Authentication)
ADMIN_EMAIL=ahmadzaid.simetri@gmail.com
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_JWT_SECRET=your_secret_session_token_key

# Kontak toko yang tampil ke pengunjung
NEXT_PUBLIC_STORE_WHATSAPP=628xxxxxxxxxx
